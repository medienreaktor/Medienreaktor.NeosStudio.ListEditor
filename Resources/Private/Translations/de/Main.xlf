<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file original="" product-name="Medienreaktor.NeosStudio.ListEditor" source-language="en" datatype="plaintext" target-language="de">
    <body>
      <trans-unit id="add" xml:space="preserve">
        <source>Add item</source>
        <target xml:lang="de">Eintrag hinzufügen</target>
      </trans-unit>
      <trans-unit id="empty" xml:space="preserve">
        <source>No items yet.</source>
        <target xml:lang="de">Noch keine Einträge.</target>
      </trans-unit>
      <trans-unit id="item.move" xml:space="preserve">
        <source>Move item {0}</source>
        <target xml:lang="de">Eintrag {0} verschieben</target>
      </trans-unit>
      <trans-unit id="item.moveHint" xml:space="preserve">
        <source>Drag to reorder, or use the arrow keys</source>
        <target xml:lang="de">Zum Umsortieren ziehen oder die Pfeiltasten benutzen</target>
      </trans-unit>
      <trans-unit id="item.remove" xml:space="preserve">
        <source>Remove item {0}</source>
        <target xml:lang="de">Eintrag {0} entfernen</target>
      </trans-unit>
      <trans-unit id="item.removeMin" xml:space="preserve">
        <source>At least {0} items are required</source>
        <target xml:lang="de">Mindestens {0} Einträge sind erforderlich</target>
      </trans-unit>
      <trans-unit id="error.unknownEditor" xml:space="preserve">
        <source>The editor "{0}" is not registered.</source>
        <target xml:lang="de">Der Editor „{0}“ ist nicht registriert.</target>
      </trans-unit>
      <trans-unit id="error.invalidOption" xml:space="preserve">
        <source>The editor option "{0}" is invalid ({1}).</source>
        <target xml:lang="de">Die Editor-Option „{0}“ ist ungültig ({1}).</target>
      </trans-unit>
      <trans-unit id="error.notAList" xml:space="preserve">
        <source>The stored value is not a list and cannot be edited here.</source>
        <target xml:lang="de">Der gespeicherte Wert ist keine Liste und kann hier nicht bearbeitet werden.</target>
      </trans-unit>
      <trans-unit id="error.expectedObject" xml:space="preserve">
        <source>Item {0} is a plain value, but the configuration expects objects (itemKey or properties).</source>
        <target xml:lang="de">Eintrag {0} ist ein einfacher Wert, die Konfiguration erwartet aber Objekte (itemKey oder properties).</target>
      </trans-unit>
      <trans-unit id="error.expectedScalar" xml:space="preserve">
        <source>Item {0} is an object, but the configuration expects plain values. Configure itemKey or properties.</source>
        <target xml:lang="de">Eintrag {0} ist ein Objekt, die Konfiguration erwartet aber einfache Werte. Konfiguriere itemKey oder properties.</target>
      </trans-unit>
    </body>
  </file>
</xliff>
